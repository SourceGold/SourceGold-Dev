.text-region {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.5);
    min-height: auto;
    min-width: auto;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

.one-line-diaglog {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 16px;
    padding-left: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    flex-wrap: nowrap;
    white-space: normal;
    padding-right: 16px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
}
